{
  "expo": {
    "name": "ChalzTracker",
    "slug": "chalztracker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/chalz-icon-192.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/chalz-icon-192.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chalztracker.mobile",
      "backgroundColor": "#000000",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.chalztracker.mobile",
      "backgroundColor": "#000000",
      "adaptiveIcon": {
        "foregroundImage": "./assets/chalz-icon-192.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/chalz-icon-192.png",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
